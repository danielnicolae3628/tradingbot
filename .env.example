# Trading Bot Configuration Template
# Copy this to .env and fill in your values

# ======================
# KUCOIN API CREDENTIALS
# ======================
# Get these from: https://www.kucoin.com/account/api
# Required Permissions: Spot Trading, Margin Trading, Transfer

KUCOIN_API_KEY=---------
KUCOIN_API_SECRET=---------
KUCOIN_API_PASSPHRASE=----------

# ======================
# TELEGRAM BOT SETUP
# ======================
# 1. Create bot: Message @BotFather on Telegram
# 2. Send: /newbot
# 3. Follow instructions to get token
# 4. Get chat ID: Message @userinfobot

TELEGRAM_BOT_TOKEN=---------
TELEGRAM_CHAT_ID=-------

# ======================
# TRADING PARAMETERS
# ======================
# Uncomment and modify these to override defaults in code

# Capital per trade (USDT)
# TRADE_CAPITAL=10

# Leverage multiplier (1-3, 2 is recommended)
# LEVERAGE=2

# Maximum trades per day
# MAX_DAILY_TRADES=5

# Daily loss limit (as decimal, -0.02 = -2%)
# MAX_DAILY_LOSS=-0.02

# Daily profit target (as decimal, 0.01 = 1%)
# DAILY_PROFIT_TARGET=0.01

# Take profit percentage (0.015 = 1.5%)
# TAKE_PROFIT_PCT=0.015

# Stop loss percentage (0.008 = 0.8%)
# STOP_LOSS_PCT=0.008

# Loop interval in seconds
# LOOP_INTERVAL=10

# ======================
# TRADING SYMBOLS
# ======================
# Edit in the Python file to add/remove trading pairs
# Default: BTC-USDT, ETH-USDT, XRP-USDT

# ======================
# NOTES
# ======================
# - Start with small TRADE_CAPITAL (10-20 USDT)
# - Use 2x leverage initially
# - Monitor for first 24 hours
# - Gradually increase capital if profitable
# - Keep detailed records of performance
